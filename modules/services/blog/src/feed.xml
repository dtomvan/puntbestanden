---
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" {% if site.config.lang %}xml:lang="{{ site.lang }}"{% endif %}>
<script src="/assets/js/atom-html-transformer.js" xmlns="http://www.w3.org/1999/xhtml"></script>
   
<link rel="stylesheet" href="/assets/css/dark.css" xmlns="http://www.w3.org/1999/xhtml" />

  <style xmlns="http://www.w3.org/1999/xhtml">
  feed {
      font-family: sans-serif;
      max-width: 38em;
      margin: 0 auto;
      padding: 1rem;
      width: auto;
      font-family: sans-serif;
      font-optical-sizing: auto;
      font-weight: 400;
      font-style: normal;
      line-height: 1.6;
      background-color: var(--ctp-base);
      color: var(--ctp-text);
  }
  entry {
      margin-bottom: 2rem;
  }
  </style>
    <generator uri="https://jorge.olano.dev/" version="0.0.1">jorge</generator>
    <link href="{{ page.url  }}" rel="self" type="application/atom+xml"/>
    <link href="{{ site.config.url }}" rel="alternate" type="text/html"/>
    <updated>{{ "now" | date_to_xmlschema }}</updated>
    <id>{{ page.url | absolute_url}}</id>
    <title type="html">{{ site.config.name }}</title>
    <author>
        <name>{{ site.config.author }}</name>
    </author>
    {% for post in site.posts limit:20 %}
        {% unless post.hidden %}
        <entry {% if post.lang %}xml:lang="{{post.lang}}"{% endif %}>
            {% assign post_title = post.title | strip_html | normalize_whitespace | xml_escape %}
            <title type="html">{% if post.repost_title %}Repost: {{post.repost_title}}{%else%}{{ post_title }}{%endif%}</title>
            <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html" title="{% if post.repost_title %}Repost: {{post.repost_title}}{%else%}{{ post_title }}{%endif%}"/>
            <published>{{ post.date | date_to_xmlschema }}</published>
            <updated>{{ post.updated | default:post.date | date_to_xmlschema }}</updated>
            <id>{{ post.repost_url | default:post.url | absolute_url }}</id>
            <author>
                <name>{{ post.author | default:site.config.author }}</name>
                {% if post.author_url %}<uri>{{ post.author_url }}</uri>{% endif %}
            </author>
            {% for tag in post.tags %}
            <category term="{{ tag }}"/>
            {% endfor %}
            <summary type="html"><![CDATA[
            {% if post.repost_url %}
              <p>
                  This is a repost of <a href="{{post.repost_url}}">{{post.repost_title}}</a> by {% if
                  post.author_url %}<a href="{{post.author_url}}">{{post.author}}</a>{% else
                  %}{{post.author}}{% endif %}. Go check it out!
              </p>
            {% endif %}
            {% if post.summary %}
                {{ post.summary | strip_html | normalize_whitespace }}
            {%else%}
                {{ post.excerpt | strip_html | normalize_whitespace }}
            {%endif%}
            <hr/><p>If you're reading this, you're using RSS! You are officially amazing. Thank you for reading!</p>]]></summary>
            {% if post.image %}
            <media:thumbnail xmlns:media="http://search.yahoo.com/mrss/" url="{{ post.image | absolute_url }}"/>
            <media:content medium="image" url="{{ post.image | absolute_url }}"  xmlns:media="http://search.yahoo.com/mrss/"/>
            {% endif %}
        </entry>
        {% endunless %}
    {% endfor %}
</feed>
